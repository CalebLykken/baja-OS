# Shuts the Pi down cleanly after key-off: backend/ignition.py watches the
# key (an optocoupler on the accessory wire, GPIO5) and runs `systemctl
# poweroff` once it has stayed off for 5 s, inside the minute the off-delay
# relay keeps the power on. Installed by deploy/setup-pi.sh, which fills in
# @APP@.
#
# Root, since it powers the Pi off, and on its own rather than in the
# dashboard, so a crashed dashboard can't stop it.
#
#   journalctl -u baja-ignition -f               what it sees
#   sudo systemctl stop baja-ignition            before a dry run (it holds the pin)
#   sudo systemctl disable --now baja-ignition   turn it off

[Unit]
Description=Baja OS key-off shutdown

[Service]
WorkingDirectory=@APP@
ExecStart=/usr/bin/python3 -u -m backend.ignition
# It exits with an error if the poweroff fails; start again and retry.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
